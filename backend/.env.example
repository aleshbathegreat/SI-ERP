DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=si-erp-api.mushaz.com,si-erp.mushaz.com,localhost
CORS_ALLOWED_ORIGINS=https://si-erp.mushaz.com
FRONTEND_URL=https://si-erp.mushaz.com
# SaaS: tenants get {code}.si-erp.mushaz.com ; custom domains via Settings → Domain
PLATFORM_ROOT_DOMAIN=si-erp.mushaz.com
PLATFORM_HOSTS=si-erp.mushaz.com,si-erp-api.mushaz.com
ALLOW_TENANT_CUSTOM_DOMAINS=true
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
DJANGO_CSRF_TRUSTED_ORIGINS=https://si-erp.mushaz.com,https://si-erp-api.mushaz.com

# Docker / Postgres
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sigbl
# DB_USER=sigbl
# DB_PASSWORD=sigblpassword
# DB_HOST=postgres
# DB_PORT=5432
# APP_DOMAIN=si-erp.mushaz.com
# API_DOMAIN=si-erp-api.mushaz.com
# Host frontend build (bake into Next standalone before docker compose build web):
#   NEXT_PUBLIC_API_URL=https://si-erp-api.mushaz.com/api
# RUN_SEED=0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

THROTTLE_ANON=30/min
THROTTLE_USER=120/min
THROTTLE_LOGIN=10/min
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=24
SOD_ENFORCE=True
MFA_ISSUER=SIGBL ERP
LOG_LEVEL=INFO
